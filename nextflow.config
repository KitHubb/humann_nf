includeConfig 'conf/base.config'

profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = params.singularity_cache
    }

    test {
        params.max_parallel_samples = 1
        params.humann_cpus = 4
        params.humann_memory = '32 GB'
        params.humann_time = '24h'
    }
}

process {
    executor = 'local'
    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
    maxRetries = 2

    withLabel: humann {
        container = params.humann_container
        cpus = params.humann_cpus
        memory = params.humann_memory
        time = params.humann_time

        publishDir = [
            path: { "${params.outdir}/humann/${meta.id}" },
            mode: params.publish_mode,
            overwrite: true,
            saveAs: { filename -> filename.contains('humann_temp') ? null : filename }
        ]
    }

    withName: JOIN_TABLES {
        publishDir = [path: "${params.outdir}/joined", mode: params.publish_mode, overwrite: true]
    }

    withName: RENORM_TABLE {
        publishDir = [path: "${params.outdir}/normalized", mode: params.publish_mode, overwrite: true]
    }

    withName: SPLIT_STRATIFIED {
        publishDir = [path: "${params.outdir}/split", mode: params.publish_mode, overwrite: true]
    }
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
}
dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/dag.html"
}

manifest {
    name = 'humann_nf'
    author = 'KSY'
    description = 'Minimal configurable HUMAnN 3 workflow for paired host-filtered shotgun reads'
    version = '1.0.0'
    nextflowVersion = '>=24.04.0'
}
